{
  "name": "editora-roel-site",
  "version": "1.0.0",
  "private": true,
  "description": "Site institucional e catálogo da Editora ROEL.",
  "type": "module",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=20.11"
  },
  "packageManager": "pnpm@10.4.1",
  "scripts": {
    "dev": "vite --host",
    "check": "tsc --noEmit",
    "build": "vite build",
    "build:static": "pnpm build && node scripts/prepare-static.mjs",
    "verify": "node scripts/verify-build.mjs",
    "test:routes": "node scripts/test-routes.mjs",
    "start": "node scripts/serve.mjs site",
    "preview": "vite preview --host",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "lucide-react": "0.453.0",
    "react": "19.2.1",
    "react-dom": "19.2.1",
    "wouter": "3.7.1"
  },
  "devDependencies": {
    "@types/node": "24.7.0",
    "@types/react": "19.2.1",
    "@types/react-dom": "19.2.1",
    "@vitejs/plugin-react": "5.0.4",
    "prettier": "3.6.2",
    "typescript": "5.6.3",
    "vite": "7.1.7"
  }
}
